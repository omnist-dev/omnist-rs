  "fixtures": [
    {
      "module": "test_oml.test_scalar_round_trip",
      "note": "OML: string scalar parses and round-trips through write_oml",
      "kind": "oml_roundtrip",
      "input": "a: \"hello\"",
      "expected": {
        "$edges": [
          [
            "a",
            {
              "$str": "hello"
            }
          ]
        ]
      }
    },
