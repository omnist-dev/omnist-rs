      "module": "test_oml.test_unmatched_close_bracket_is_a_parse_error",
      "note": "OML: unmatched close bracket is a ParseError",
      "kind": "oml_parse_error",
      "input": "a: ]",
      "error_contains": "line 1, col 4: expected a value, got RBRACKET ']'"
    },
